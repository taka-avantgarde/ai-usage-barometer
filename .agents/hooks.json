{
  "aib-physical-guard": {
    "PostToolUse": [
      {
        "matcher": "write_file|edit_file|write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "node /Users/takayukimiyano/ai-usage-barometer/scripts/aib_guard.mjs --post",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "node /Users/takayukimiyano/ai-usage-barometer/scripts/aib_guard.mjs --stop",
        "timeout": 20
      }
    ]
  }
}
